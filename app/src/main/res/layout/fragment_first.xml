<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".FirstFragment">

    <!-- Header -->
    <TextView
        android:id="@+id/charName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="22sp"
        tools:text="Cinder Ruuveld"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/charClass"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="Blood Hunter (Order of the Mutant) — L13"
        app:layout_constraintTop_toBottomOf="@id/charName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <!-- Quick stats -->
    <LinearLayout
        android:id="@+id/quickStats"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="4"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/charClass"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/acVal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:text="AC: 16"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/hpVal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:text="HP: 100"
            android:gravity="center"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/speedVal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:text="Speed: 30"
            android:gravity="end"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/initiativeVal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:text="Init: 3"
            android:gravity="end"
            android:textStyle="bold"/>
    </LinearLayout>

    <!--  Abilities header - does not show up yet  -->
    <TextView
        android:id="@+id/abilitiesLineHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="22sp"
        android:layout_marginTop="15dp"
        tools:text="Abilities"
        app:layout_constraintTop_toBottomOf="@id/quickStats"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Abilities (3 columns x 2 rows) -->
    <GridLayout
        android:id="@+id/quickAbilitiesStats"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:columnCount="3"
        android:rowCount="2"
        android:alignmentMode="alignMargins"
        android:useDefaultMargins="true"
        app:layout_constraintTop_toBottomOf="@id/abilitiesLineHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- STR -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/strLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STRENGTH"
                android:textStyle="bold"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/strVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="16 (+3)"/>
        </LinearLayout>

        <!-- DEX -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEXTERITY"
                android:textStyle="bold"
                android:textSize="12sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/dexVal"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="12 (+1)"/>
        </LinearLayout>

        <!-- CON -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONSTITUTION"
                android:textStyle="bold"
                android:textSize="12sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/conVal"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="16 (+3)"/>
        </LinearLayout>

        <!-- INT -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INTELLIGENCE"
                android:textStyle="bold"
                android:textSize="12sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/intVal"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="16 (+3)"/>

        </LinearLayout>

        <!-- WIS -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WISDOM"
                android:textStyle="bold"
                android:textSize="12sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/wisVal"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="10 (+0)"/>

        </LinearLayout>

        <!-- CHA -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHARISMA"
                android:textStyle="bold"
                android:textSize="12sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/chaVal"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="8 (-1)"/>

        </LinearLayout>
    </GridLayout>

    <!--  Saving throws section  -->
    <TextView
        android:id="@+id/savingThrowsHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Saving Throws"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/quickAbilitiesStats"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 2 columns, 3 rows;" -->
    <GridLayout
        android:id="@+id/savingThrowsGrid"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:useDefaultMargins="true"
        android:alignmentMode="alignMargins"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/savingThrowsHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Row 1: STR & INT -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="6dp">
            <TextView
                android:id="@+id/strSaveLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="STRENGTH"
                android:textAllCaps="true"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/strSaveVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+0"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="6dp">
            <TextView
                android:id="@+id/intSaveLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="INTELLIGENCE"
                android:textAllCaps="true"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/intSaveVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+0"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Row 2: DEX & WIS -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="6dp">
            <TextView
                android:id="@+id/dexSaveLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="DEXTERITY"
                android:textAllCaps="true"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/dexSaveVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+0"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="6dp">
            <TextView
                android:id="@+id/wisSaveLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="WISDOM"
                android:textAllCaps="true"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/wisSaveVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+0"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Row 3: CON & CHA -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="6dp">
            <TextView
                android:id="@+id/conSaveLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CONSTITUTION"
                android:textAllCaps="true"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/conSaveVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+0"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="6dp">
            <TextView
                android:id="@+id/chaSaveLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CHARISMA"
                android:textAllCaps="true"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/chaSaveVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+0"
                android:textStyle="bold"/>
        </LinearLayout>

    </GridLayout>




</androidx.constraintlayout.widget.ConstraintLayout>
